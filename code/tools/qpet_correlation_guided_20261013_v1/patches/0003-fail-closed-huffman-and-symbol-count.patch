+            virtual std::vector<T> decode(
+                    const uchar *&bytes, size_t targetLength, size_t &remaining_length) {
+                const auto *begin = bytes;
+                auto decoded = decode(bytes, targetLength);
+                const auto consumed = static_cast<size_t>(bytes - begin);
+                if (consumed > remaining_length)
+                    throw CodecFormatError("encoder consumed beyond the available payload");
+                remaining_length -= consumed;
+                return decoded;
+            }
+
             virtual void postprocess_decode() = 0;
 
